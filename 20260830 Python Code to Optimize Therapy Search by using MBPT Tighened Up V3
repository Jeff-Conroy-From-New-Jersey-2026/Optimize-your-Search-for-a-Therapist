# RATING SYMBOLS
# ---------------------------------------------------------

RATING_SYMBOLS = {
    3: "◎ (Ideal)",
    2: "○ (Good)",
    1: "△ (Neutral)",
    0: "✖ (Poor)",
}

# ---------------------------------------------------------
# CORE FUNCTIONS
# ---------------------------------------------------------

def best_matches(patient_type, top_n=5):
    """Return top therapist matches for a patient type along with rating symbols."""
    scores = compatibility_matrix.get(patient_type)
    if not scores:
        raise ValueError("Invalid MBTI type")

    sorted_matches = sorted(scores.items(), key=lambda x: x[1], reverse=True)
    return sorted_matches[:top_n]

def describe_type(mbti):
    """Return descriptor block for a given MBTI type."""
    return mbti_descriptors.get(mbti, "Unknown MBTI type")

